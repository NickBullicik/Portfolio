---
import type { Dict } from '../i18n/es';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap">
    <p>{t.footer}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
  }

  .wrap {
    padding-block: 28px;
    color: var(--color-fg-3);
    font-size: 0.875rem;
  }
</style>
