---
import { Image } from 'astro:assets';
import { nizzTags } from '../data/projects';
import { site } from '../data/site';
import type { Dict } from '../i18n/es';
import ficharElegir from '../assets/shots/nizz-fichar-elegir-m.png';
import revisar from '../assets/shots/nizz-revisar-m.png';
import semana from '../assets/shots/nizz-semana-m.png';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const screens = [
  { src: ficharElegir, alt: t.alt.nizzFicharElegir },
  { src: revisar, alt: t.alt.nizzRevisar },
  { src: semana, alt: t.alt.nizzSemana },
];
const steps = t.nizz.steps.map((text, i) => ({ text, ...screens[i] }));
---

<section class="section section-subtle nizz" id="nizz" aria-labelledby="nizz-title">
  <div class="wrap">
    <div class="nizz-head">
      <div class="nizz-title">
        <div class="nizz-title-row">
          <span class="via via-lg" aria-hidden="true"><span><small>{t.platformSign}</small>1</span></span>
          <h2 class="nizz-name" id="nizz-title" translate="no">NIZZ</h2>
        </div>
        <p class="nizz-what">{t.nizz.what}</p>
        <div class="nizz-links">
          <a class="link link-arrow" href={site.nizzUrl} target="_blank" rel="noopener"
            >{t.nizz.visit}<svg class="icon icon-ne" aria-hidden="true"><use href="#i-ne"></use></svg></a
          >
        </div>
      </div>
      <dl class="facts">
        <div>
          <dt>{t.nizz.statusLabel}</dt>
          <dd><span class="chip-live">{t.inService}</span><span class="fact-line">{t.nizz.statusText}</span></dd>
        </div>
        <div>
          <dt>{t.nizz.roleLabel}</dt>
          <dd>{t.nizz.roleText}</dd>
        </div>
        <div>
          <dt>{t.nizz.techLabel}</dt>
          <dd>
            <ul class="chips" translate="no" aria-label={t.nizz.techListLabel}>
              {nizzTags.map((tag) => <li class="chip">{tag}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </div>

    <div class="story" data-story>
      <ol class="steps" aria-label={t.nizz.stepsLabel}>
        {
          steps.map((step, i) => (
            <li class:list={['step', { 'is-active': i === 0 }]}>
              <div>
                <p class="step-index mono" aria-hidden="true">{i + 1}/{steps.length}</p>
                <p class="step-text">{step.text}</p>
              </div>
              <figure class="step-figure">
                <div class="phone">
                  <div class="phone-screen">
                    <Image src={step.src} alt={step.alt} widths={[240, 390]} sizes="190px" />
                  </div>
                </div>
              </figure>
            </li>
          ))
        }
      </ol>
      <div class="stage" aria-hidden="true">
        <div class="stage-inner">
          <div class="phone">
            <div class="phone-screen" data-stage-screens>
              {steps.map((step) => <Image src={step.src} alt="" widths={[240, 390]} sizes="290px" />)}
            </div>
          </div>
          <div class="stage-progress" data-stage-progress>
            {steps.map((_, i) => <i class:list={{ 'is-on': i === 0, 'is-current': i === 0 }} />)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .nizz {
    padding-top: 0;
  }

  .nizz-head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: end;
    gap: 32px;
  }

  .nizz-title {
    grid-column: 1 / span 7;
  }

  .nizz-title-row {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nizz-name {
    font-size: clamp(3rem, 2rem + 3.6vw, 5rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .nizz-what {
    max-width: 24ch;
    margin-top: 18px;
    color: var(--color-fg-2);
    font-size: clamp(1.375rem, 1.05rem + 1.1vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .nizz-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 24px;
    margin-top: 24px;
  }

  .facts {
    grid-column: 9 / span 4;
    display: grid;
  }

  .facts > div {
    padding: 16px 0;
    border-top: 1px solid var(--color-line-strong);
  }

  .facts dt {
    color: var(--color-fg-3);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .facts dd {
    margin-top: 6px;
    font-size: 1rem;
    line-height: 1.45;
  }

  .fact-line {
    display: block;
    margin-top: 8px;
  }

  .facts .chips {
    margin-top: 2px;
  }

  /* Cómo funciona: apilado por defecto; con JS en escritorio, el móvil queda fijo y cambia de pantalla. */
  .story {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 32px;
    margin-top: clamp(56px, 8vw, 104px);
  }

  .steps {
    grid-column: 1 / -1;
    display: grid;
    gap: 48px;
  }

  .step {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--color-line-strong);
  }

  .step-index {
    color: var(--color-fg-3);
    font-size: 0.875rem;
  }

  .step-text {
    max-width: 26ch;
    margin-top: 10px;
    color: var(--color-ink);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.025em;
    text-wrap: pretty;
    transition: color 300ms var(--ease-out);
  }

  .step-figure {
    width: 180px;
  }

  .step-figure .phone {
    padding: 6px;
    border-radius: 30px;
  }

  .step-figure .phone-screen {
    border-radius: 24px;
  }

  .stage {
    display: none;
  }

  /* Con JS y en escritorio, la disposición fija se aplica desde el primer pintado para no mover nada al cargar GSAP. */
  @media (min-width: 1024px) {
    :global(.js) .story {
      margin-top: 24px;
    }

    :global(.js) .steps {
      grid-column: 1 / span 6;
      gap: 0;
    }

    :global(.js) .step {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 72vh;
      padding: 0;
      border: 0;
    }

    :global(.js) .step-figure {
      display: none;
    }

    :global(.js) .step-text {
      font-size: clamp(2rem, 1.2rem + 1.4vw, 2.5rem);
    }

    :global(.js) .story:global(.is-live) .step:not(.is-active) .step-text {
      color: var(--color-fg-muted);
    }

    :global(.js) .stage {
      display: block;
      grid-column: 8 / span 5;
    }
  }

  .stage-inner {
    position: sticky;
    top: calc(50vh - 320px);
    display: grid;
    justify-items: center;
    padding-block: 24px;
  }

  .stage .phone {
    width: 290px;
  }

  .stage .phone-screen :global(img) {
    position: absolute;
    inset: 0;
  }

  .stage .phone-screen :global(img:not(:first-child)) {
    opacity: 0;
  }

  .stage-progress {
    display: flex;
    gap: 6px;
    margin-top: 20px;
  }

  .stage-progress i {
    width: 28px;
    height: 3px;
    border-radius: 3px;
    background: var(--color-line-strong);
    transition:
      background-color 300ms var(--ease-out),
      width 400ms var(--ease-expo);
  }

  .stage-progress i:global(.is-on) {
    background: var(--color-adif);
  }

  .stage-progress i:global(.is-current) {
    width: 44px;
  }

  @media (max-width: 1023px) {
    .nizz-title,
    .facts {
      grid-column: 1 / -1;
    }

    .facts {
      grid-template-columns: repeat(3, 1fr);
      gap: 0 24px;
    }
  }

  @media (max-width: 719px) {
    .nizz-head,
    .story {
      grid-template-columns: minmax(0, 1fr);
    }

    .nizz-title-row {
      gap: 16px;
    }

    .facts {
      grid-template-columns: 1fr;
    }

    .step {
      grid-template-columns: 1fr;
    }

    .step-figure {
      justify-self: center;
      width: 190px;
    }
  }
</style>

<script>
  import { initStory } from '../scripts/motion';

  initStory();
</script>
