---
import type { Dict } from '../i18n/es';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<header class="site-header" data-header>
  <div class="wrap">
    <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true">NM</span><span class="brand-name" translate="no">Nicolás Mazzilli</span></a>
    <div class="header-end">
      <nav class="nav" aria-label={t.navLabel}>
        <a href="#nizz">{t.nav.nizz}</a>
        <a href="#proyectos">{t.nav.projects}</a>
        <a href="#trayectoria">{t.nav.background}</a>
      </nav>
      <p class="clock">
        <span class="live-dot" aria-hidden="true"></span><span aria-hidden="true">Alicante</span><span class="sr-only">{t.clockLabel}:</span>
        <time class="clock-time mono" data-clock><span data-clock-hm>--:--</span>:<span class="clock-ss"><span data-clock-ss>--</span></span></time>
      </p>
      <a class="lang" href={t.langSwitch.href} hreflang={t.langSwitch.hreflang} lang={t.langSwitch.hreflang}
        >{t.langSwitch.label}<span class="sr-only">, {t.langSwitch.title}</span></a
      >
      <a class="btn btn-secondary btn-small" href="#contacto">{t.writeMe}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-bg) 96%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-line);
  }

  .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--spacing-tap);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .brand-mark {
    transition: background-color var(--duration-base) var(--ease-out);
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--color-adif);
    color: var(--color-on-dark);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-mark {
      background: var(--color-adif-deep);
    }
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav a,
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--spacing-tap);
    padding: 0 12px;
    border-radius: var(--radius-md);
    color: var(--color-fg-2);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .lang {
    min-width: var(--spacing-tap);
    padding: 0 10px;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover,
    .lang:hover {
      color: var(--color-ink);
      background: var(--color-bg-subtle);
    }
  }

  .clock {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-left: 16px;
    border-left: 1px solid var(--color-line);
    color: var(--color-fg-3);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  /* Horas, minutos y segundos comparten caja y alto de línea para que los segundos no se descuelguen. */
  .clock-time {
    display: inline-flex;
    align-items: center;
    height: 1.3em;
    min-width: 8ch;
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .clock-ss {
    display: block;
    height: 1.3em;
    overflow: hidden;
  }

  .clock-ss span {
    display: block;
  }

  :global(.no-js) .clock {
    display: none;
  }

  @media (max-width: 1100px) {
    .clock {
      display: none;
    }
  }

  @media (max-width: 719px) {
    .wrap {
      height: 60px;
      gap: 12px;
    }

    .nav {
      display: none;
    }

    .header-end {
      gap: 8px;
    }
  }

  @media (max-width: 419px) {
    .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>

<script>
  import { site } from '../data/site';

  const header = document.querySelector<HTMLElement>('[data-header]');
  const top = document.getElementById('top');
  if (header && top) {
    new IntersectionObserver(([entry]) => header.classList.toggle('is-scrolled', entry.boundingClientRect.top < 0), {
      threshold: [0, 1],
      rootMargin: '-8px 0px 0px 0px',
    }).observe(top);
  }

  // Reloj de Alicante (hora de Madrid); los segundos caen como una ficha del panel.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  const hm = clock?.querySelector<HTMLElement>('[data-clock-hm]');
  const ss = clock?.querySelector<HTMLElement>('[data-clock-ss]');
  if (clock && hm && ss) {
    const fmt = new Intl.DateTimeFormat('es-ES', {
      timeZone: site.timeZone,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    });
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const spring = getComputedStyle(document.documentElement).getPropertyValue('--ease-spring').trim() || 'ease-out';
    const tick = () => {
      const parts = Object.fromEntries(fmt.formatToParts(new Date()).map((p) => [p.type, p.value]));
      hm.textContent = `${parts.hour}:${parts.minute}`;
      clock.dateTime = `${parts.hour}:${parts.minute}:${parts.second}`;
      if (ss.textContent === parts.second) return;
      ss.textContent = parts.second;
      if (document.hidden || reduce.matches) return;
      ss.animate([{ transform: 'translateY(-100%)' }, { transform: 'translateY(0)' }], { duration: 220, easing: spring });
    };
    tick();
    let timer = window.setInterval(tick, 1000);
    document.addEventListener('visibilitychange', () => {
      window.clearInterval(timer);
      if (!document.hidden) {
        tick();
        timer = window.setInterval(tick, 1000);
      }
    });
  }
</script>
